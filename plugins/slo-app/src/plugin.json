{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "SLO Analysis App",
  "id": "jordo-slo-app",
  "info": {
    "keywords": ["app", "slo", "heatmap", "traces", "latency", "error-rate", "comparison"],
    "description": "SLO monitoring with heatmap drilldown and attribute comparison for root-cause analysis",
    "author": {
      "name": "Jordan Simonovski",
      "url": "https://github.com/jordan-simonovski"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/jordan-simonovski/event-deltas"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/jordan-simonovski/event-deltas/blob/main/plugins/slo-app/README.md"
      },
      {
        "name": "License",
        "url": "https://github.com/jordan-simonovski/event-deltas/blob/main/plugins/slo-app/LICENSE"
      }
    ],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Investigations",
      "path": "/a/%PLUGIN_ID%/investigations",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "SLO Catalog",
      "path": "/a/%PLUGIN_ID%/catalog",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Ownership",
      "path": "/a/%PLUGIN_ID%/ownership",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Operations",
      "path": "/a/%PLUGIN_ID%/operations",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": [
      {
        "id": "jordo-event-deltas-panel",
        "name": "Event Deltas",
        "type": "panel",
        "version": ">=2.0.0"
      },
      {
        "id": "jordo-timeseries-selection-panel",
        "name": "Timeseries Selection",
        "type": "panel",
        "version": ">=2.0.0"
      }
    ]
  }
}
